<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialMediaSimulator.Client.Views.SearchPage"
             Title="Search"
             BackgroundColor="#1A1A24">
    <VerticalStackLayout Padding="15" BackgroundColor="#1A1A24">
        <SearchBar Placeholder="Search accounts and posts..."
                   Text="{Binding SearchQuery}"
                   SearchCommand="{Binding SearchCommand}"
                   BackgroundColor="#242430"
                   TextColor="#F5F5F7"
                   PlaceholderColor="#606070"/>

        <!-- Trends Section -->
        <Label Text="Trending" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5" TextColor="#F5F5F7"
               IsVisible="{Binding HasSearched, Converter={StaticResource InverseBoolConverter}}"/>
        
        <CollectionView ItemsSource="{Binding Trends}" HeightRequest="100"
                        IsVisible="{Binding HasSearched, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#1A1A24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="5" Padding="10" BackgroundColor="#F5A623" CornerRadius="10">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" TextColor="#1A1A10"/>
                            <Label Text="{Binding PostCount, StringFormat='{}{0} posts'}" FontSize="11" TextColor="#333333"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Search Results -->
        <Label Text="Accounts" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5" TextColor="#F5F5F7"
               IsVisible="{Binding HasSearched}"/>
        <CollectionView ItemsSource="{Binding Accounts}" HeightRequest="80"
                        IsVisible="{Binding HasSearched}"
                        BackgroundColor="#1A1A24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Margin="0,5">
                        <Frame WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#333344">
                            <Label Text="{Binding Profile.DisplayName[0]}" FontSize="18" FontAttributes="Bold" 
                                   TextColor="#F5A623" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Frame>
                        <VerticalStackLayout Margin="10,0">
                            <Label Text="{Binding Profile.DisplayName}" FontAttributes="Bold" TextColor="#F5F5F7"/>
                            <Label Text="{Binding Username, StringFormat='@{0}'}" FontSize="12" TextColor="#9E9EA8"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Text="Posts" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5" TextColor="#F5F5F7"
               IsVisible="{Binding HasSearched}"/>
        <CollectionView ItemsSource="{Binding Posts}"
                        IsVisible="{Binding HasSearched}"
                        BackgroundColor="#1A1A24">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,5" Padding="10" BackgroundColor="#242430" CornerRadius="8">
                        <VerticalStackLayout>
                            <Label Text="{Binding AuthorDisplayName}" FontAttributes="Bold" TextColor="#F5F5F7"/>
                            <Label Text="{Binding Content}" MaxLines="2" LineBreakMode="TailTruncation" TextColor="#EDEDED"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsSearching}" HorizontalOptions="Center" Margin="0,20" Color="#F5A623"/>
    </VerticalStackLayout>
</ContentPage>
