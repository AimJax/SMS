<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialMediaSimulator.Client.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="#1A1A24">
    <Grid BackgroundColor="#1A1A24">
        <ScrollView>
            <VerticalStackLayout Padding="10" BackgroundColor="#1A1A24">
                <!-- Notifications will be added dynamically -->
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="EmptyLabel" Text="No notifications yet" FontSize="16" TextColor="#606070"
               HorizontalOptions="Center" VerticalOptions="Center"
               IsVisible="False"/>
    </Grid>
</ContentPage>
