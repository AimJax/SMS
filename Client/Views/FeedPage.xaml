<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialMediaSimulator.Client.Views.FeedPage"
             Title="Home"
             BackgroundColor="#1A1A24">
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="search" Command="{Binding NavigateToSearchCommand}"/>
    </ContentPage.ToolbarItems>

    <Grid BackgroundColor="#1A1A24">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}" BackgroundColor="#1A1A24">
            <CollectionView ItemsSource="{Binding Posts}" 
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            BackgroundColor="#1A1A24">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="10,5" Padding="15" BackgroundColor="#242430" CornerRadius="12">
                            <VerticalStackLayout Spacing="10">
                                <!-- Author Header -->
                                <HorizontalStackLayout Spacing="10">
                                    <Frame WidthRequest="40" HeightRequest="40" CornerRadius="20" Padding="0" BackgroundColor="#333344">
                                        <Label Text="{Binding AuthorDisplayName[0]}" FontSize="18" FontAttributes="Bold" 
                                               TextColor="#F5A623" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <VerticalStackLayout>
                                        <Label Text="{Binding AuthorDisplayName}" FontAttributes="Bold" FontSize="14" TextColor="#F5F5F7"/>
                                        <Label Text="{Binding AuthorUsername}" FontSize="12" TextColor="#9E9EA8"/>
                                    </VerticalStackLayout>
                                    <Label Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, HH:mm}'}" 
                                           FontSize="11" TextColor="#606070" HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>

                                <!-- Content -->
                                <Label Text="{Binding Content}" FontSize="15" LineBreakMode="WordWrap" TextColor="#F5F5F7"/>

                                <!-- Topic -->
                                <Label Text="{Binding Topic}" FontSize="12" TextColor="#F5A623"/>

                                <!-- Actions -->
                                <HorizontalStackLayout Spacing="20">
                                    <Button Text="{Binding LikeCount, StringFormat='♥ {0}'}" 
                                            Command="{Binding Source={RelativeSource AncestorType=CollectionView}, Path=BindingContext.LikePostCommand}"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="Transparent"
                                            TextColor="#CF4A30"/>
                                    <Button Text="{Binding CommentCount, StringFormat='💬 {0}'}"
                                            Command="{Binding Source={RelativeSource AncestorType=CollectionView}, Path=BindingContext.CommentPostCommand}"
                                            CommandParameter="{Binding}"
                                            BackgroundColor="Transparent"
                                            TextColor="#9E9EA8"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Text="+" Command="{Binding CreatePostCommand}" 
                BackgroundColor="#F5A623"
                TextColor="#1A1A10"
                FontSize="24"
                WidthRequest="56"
                HeightRequest="56"
                CornerRadius="28"
                HorizontalOptions="End" VerticalOptions="End"
                Margin="20"/>

        <ActivityIndicator IsRunning="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" Color="#F5A623"/>
    </Grid>
</ContentPage>
