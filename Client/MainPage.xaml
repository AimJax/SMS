<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialMediaSimulator.Client.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,60"
            Spacing="25"
            VerticalOptions="FillAndExpand">

            <Label
                Text="Social Media Simulator"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,20" />

            <Label
                Text="Server Status"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,10" />

            <Label
                x:Name="ServerStatusLabel"
                Text="Checking..."
                FontSize="24"
                FontAttributes="Bold"
                TextColor="Gray"
                HorizontalOptions="Center" />

            <Label
                x:Name="ErrorLabel"
                Text=""
                FontSize="14"
                TextColor="Gray"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                IsVisible="False"
                Margin="0,10,0,0" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsRunning="False"
                IsVisible="False"
                Color="Blue"
                Margin="0,20,0,0" />

            <Button
                x:Name="CheckButton"
                Text="Check Server"
                Clicked="OnCheckServerClicked"
                HorizontalOptions="Center"
                WidthRequest="200"
                Margin="0,30,0,0" />

            <Label
                Text="Tap the button to check if the backend server is reachable."
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
