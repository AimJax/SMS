<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SocialMediaSimulator.Client"
             xmlns:converters="clr-namespace:SocialMediaSimulator.Client.Converters"
             x:Class="SocialMediaSimulator.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:ZeroToBoolConverter x:Key="ZeroToBoolConverter"/>
            
            <!-- Colors -->
            <Color x:Key="Primary">#007AFF</Color>
            <Color x:Key="PrimaryDark">#0056B3</Color>
            <Color x:Key="Surface">White</Color>
            <Color x:Key="SurfaceDark">#1C1C1E</Color>
            <Color x:Key="Background">#F2F2F7</Color>
            <Color x:Key="BackgroundDark">#000000</Color>
            
            <!-- Styles -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="Gray"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
            
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>
            
            <Style x:Key="FabStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="WidthRequest" Value="56"/>
                <Setter Property="HeightRequest" Value="56"/>
                <Setter Property="CornerRadius" Value="28"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
