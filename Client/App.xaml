<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SocialMediaSimulator.Client"
             xmlns:converters="clr-namespace:SocialMediaSimulator.Client.Converters"
             x:Class="SocialMediaSimulator.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Converters -->
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
            <converters:ZeroToBoolConverter x:Key="ZeroToBoolConverter"/>
            
            <!-- Base / Surface Colors - Night Terminal -->
            <Color x:Key="Background">#1A1A24</Color>
            <Color x:Key="Foreground">#F5F5F7</Color>
            <Color x:Key="Surface">#242430</Color>
            <Color x:Key="SurfaceRaised">#2C2C38</Color>
            <Color x:Key="Card">#242430</Color>
            <Color x:Key="CardForeground">#F5F5F7</Color>
            <Color x:Key="Popover">#282834</Color>
            <Color x:Key="PopoverForeground">#F5F5F7</Color>
            <Color x:Key="Border">#404050</Color>
            <Color x:Key="InputBorder">#404050</Color>
            
            <!-- Primary / Secondary Accents - Signal Amber -->
            <Color x:Key="Primary">#F5A623</Color>
            <Color x:Key="PrimaryForeground">#1A1A10</Color>
            <Color x:Key="PrimaryGlow">#FFD54F</Color>
            <Color x:Key="Secondary">#333344</Color>
            <Color x:Key="SecondaryForeground">#EDEDEF</Color>
            <Color x:Key="Muted">#2E2E3C</Color>
            <Color x:Key="MutedForeground">#9E9EA8</Color>
            <Color x:Key="Accent">#26C6DA</Color>
            <Color x:Key="AccentForeground">#0A1A1C</Color>
            <Color x:Key="Destructive">#E53935</Color>
            <Color x:Key="DestructiveForeground">#FFF5F5</Color>
            
            <!-- Simulator-Specific -->
            <Color x:Key="Verified">#26C6DA</Color>
            <Color x:Key="Like">#CF4A30</Color>
            <Color x:Key="Repost">#4CAF50</Color>
            <Color x:Key="Trend">#F5A623</Color>
            <Color x:Key="Warning">#FFC107</Color>
            <Color x:Key="Online">#4CAF50</Color>
            
            <!-- Shell/Tab Bar -->
            <Color x:Key="ShellBackground">#1A1A24</Color>
            <Color x:Key="TabBarBackground">#242430</Color>
            <Color x:Key="TabBarUnselected">#606070</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
